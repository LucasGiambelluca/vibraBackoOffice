# Vacío = Postgres embebido (PGlite) en .data/pglite (desarrollo local).
# En el VPS: postgres://usuario:clave@db:5432/vibra
DATABASE_URL=

# Obligatorio en producción (la app no arranca sin él). Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app (en el VPS, el dominio con https).
BETTER_AUTH_URL=http://localhost:3000

# Carpeta de los PDF adjuntos. Vacío = ./.data/uploads. En el VPS, un volumen persistente.
UPLOADS_DIR=

# Worker de recordatorios. En desarrollo (PGlite) poné true para que corra dentro de `npm run dev`.
# En el VPS dejalo vacío: corre `npm run worker` en su propio contenedor.
WORKER_EN_APP=

# SMTP para los emails de recordatorios. Sin SMTP_HOST, los emails se escriben en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
